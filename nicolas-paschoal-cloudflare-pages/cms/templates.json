==='series'?'Capítulos desta história':'O filme'}</h3>${f.eps.map((e,i)=>`<button class=\"episode\" data-episode=\"${i}\"><span>0${i+1}</span><img src=\"https://i.ytimg.com/vi/${e.video}/hqdefault.jpg\" alt=\"\"><div><h4>${e.title}</h4><p>${e.description||f.couple} · ${e.duration}</p></div><span>▶</span></button>`).join('')}</div></div>`;if(!detail.open)detail.showModal();document.querySelector('#watch').onclick=()=>play(f,0);document.querySelectorAll('.episode').forEach(b=>b.onclick=()=>play(f,+b.dataset.episode))}\nfunction play(f,i){const e=f.eps[i];document.querySelector('#player-content').innerHTML=`<div class=\"player-wrap\"><iframe src=\"https://www.youtube.com/embed/${e.video}?autoplay=1&rel=0\" title=\"${f.couple} — ${e.title}\" allow=\"autoplay; encrypted-media; picture-in-picture; fullscreen\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe></div><div class=\"player-note\">${f.couple} · ${e.title}<div style=\"display:flex;gap:20px;flex-wrap:wrap;margin-top:15px\"><a href=\"https://www.youtube.com/watch?v=${e.video}\" target=\"_blank\" rel=\"noopener\">Assistir no YouTube ↗</a>${i+1<f.eps.length?'<button class=\"filter\" id=\"next-episode\">Próximo capítulo →</button>':''}</div></div>`;if(!player.open)player.showModal();const next=document.querySelector('#next-episode');if(next)next.onclick=()=>play(f,i+1)}\ndetail.querySelector('.close').onclick=()=>{detail.close();history.replaceState(null,'','#filmes')};detail.addEventListener('cancel',()=>history.replaceState(null,'','#filmes'));player.querySelector('.close').onclick=()=>player.close();player.addEventListener('close',()=>document.querySelector('#player-content').innerHTML='');[detail,player].forEach(d=>d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom){d.close();if(d===detail)history.replaceState(null,'','#filmes')}}}));window.addEventListener('hashchange',route);route();document.querySelector('#year').textContent=new Date().getFullYear();\n</script></body></html>", "investment": "<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"description\" content=\"Conheça as experiências Essencial, Autoral e Íntegra. Filmes de casamento por Nicolas Paschoal.\"><title>@@investment_49@@</title><link rel=\"preconnect\" href=\"https://images.unsplash.com\"><link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\"><style>\n:root{--bg:#101110;--paper:#eae7df;--muted:#a9aaa2;--accent:#d3ff7a}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--paper);font:14px 'DM Sans',sans-serif}button,a{-webkit-tap-highlight-color:transparent}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}button:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:6px}header{position:absolute;z-index:5;top:0;left:0;width:100%;padding:28px 5%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff25}.brand{font-family:Manrope,sans-serif;font-size:18px;font-weight:800;line-height:1.05;letter-spacing:-.7px}.brand small{display:block;font:8px 'DM Sans';letter-spacing:3.2px;margin-top:8px;text-transform:uppercase}nav{display:flex;align-items:center;gap:32px;font-size:12px}.contact{border:1px solid #ffffff55;border-radius:30px;padding:12px 19px}.contact span{color:var(--accent);margin-left:20px}.hero{min-height:790px;height:92vh;max-height:1000px;position:relative;display:flex;align-items:end;padding:0 5% 85px;overflow:hidden}.hero>img,.detail-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.68) saturate(.65)}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,#101110 0%,#10111025 65%,#10